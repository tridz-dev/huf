# FasterDocker build context exclusions
.git
.github
.pytest_cache
__pycache__
*.pyc
*.pyo
*.egg-info
node_modules
frontend/node_modules
.vscode
.idea
# Keep README.md and LICENSE because pyproject.toml references them.
# *.md
.env
.env.example
.DS_Store
# Exclude bake output but keep the directory placeholder.
docker/fast/.bake-output/*
!docker/fast/.bake-output/.gitkeep
