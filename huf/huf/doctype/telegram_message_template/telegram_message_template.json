   "label": "Active"
  },
  {
   "fieldname": "column_break_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "language",
   "fieldtype": "Data",
   "label": "Language",
   "description": "Optional language code, for example en or pt-BR."
  },
  {
   "fieldname": "parse_mode",
   "fieldtype": "Select",
   "default": "HTML",
   "label": "Text formatting",
   "options": "Plain\nHTML\nMarkdownV2"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description",
