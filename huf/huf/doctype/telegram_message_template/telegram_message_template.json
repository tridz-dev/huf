   "fieldname": "template_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Template name",
   "reqd": 1,
   "unique": 1,
   "description": "Short name agents and automations use to send this template. Lowercase letters, digits, dashes and underscores."
  },
  {
   "fieldname": "gateway",
   "fieldtype": "Link",
   "label": "Gateway",
   "options": "Gateway",
