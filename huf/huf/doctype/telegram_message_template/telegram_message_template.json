   "fieldtype": "Table",
   "label": "Variables",
   "options": "Telegram Template Variable"
  },
  {
   "fieldname": "section_media",
   "fieldtype": "Section Break",
   "label": "Media and buttons"
  },
  {
   "fieldname": "media_type",
   "fieldtype": "Select",
