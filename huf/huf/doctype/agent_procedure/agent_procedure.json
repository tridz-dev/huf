   "fieldname": "schema_version",
   "fieldtype": "Data",
   "label": "Schema Version",
   "read_only": 1
  },
  {
   "description": "sha256 hex digest over the canonical form of definition_json (spec/graph-ir.md section 7). Identifies content; never recomputed or edited after insert.",
   "fieldname": "fingerprint",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Fingerprint",
   "length": 64,
   "read_only": 1
  },
  {
   "fieldname": "definition_tab",
   "fieldtype": "Tab Break",
   "label": "Definition"
  },
  {
   "description": "The full graph document (spec/graph-ir.md section 2), profile=\"procedure\". Immutable after insert -- a content change always produces a new version row (I6), never an update to this one.",
   "fieldname": "definition_json",
   "fieldtype": "JSON",
   "label": "Definition JSON",
   "reqd": 1
  },
  {
   "fieldname": "contract_section",
