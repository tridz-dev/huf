   "fieldname": "input_schema",
   "fieldtype": "JSON",
   "label": "Input Schema",
   "read_only": 1
  },
  {
   "fieldname": "output_schema",
   "fieldtype": "JSON",
   "label": "Output Schema",
   "read_only": 1
  },
