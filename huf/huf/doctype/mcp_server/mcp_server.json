   "description": "Header name for authentication (e.g., 'Authorization', 'X-API-Key')"
  },
  {
   "fieldname": "auth_header_value",
   "fieldtype": "Password",
   "label": "Auth Header Value",
   "depends_on": "eval:doc.auth_type && doc.auth_type !== 'none'",
