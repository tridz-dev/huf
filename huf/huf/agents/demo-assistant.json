{
  "agent_name": "Demo Assistant",
  "description": "A demo agent using Google's gemini-3.5-flash-lite. Add your Google AI Provider API key to chat.",
  "provider": "Google",
  "model": "gemini-3.5-flash-lite",
  "prompt_mode": "Local",
  "instructions": "You are a helpful, concise assistant. Answer the user's questions clearly and accurately. If you don't know something, say so.",
  "temperature": 0.7,
  "top_p": 1,
  "allow_chat": 1,
  "persist_conversation": 1,
  "disabled": 0,
  "context_strategy": "Summarize",
  "history_limit": 20,
  "max_turns": 20,
  "max_knowledge_tokens": 4000,
  "max_context_chars": 2000,
  "autonaming_of_conversation_title": 1,
  "run_immediately": 1,
  "show_tool_execution_details": 1,
  "enable_multi_run": 0,
  "persist_user_history": 0,
  "enable_conversation_data": 0,
  "inject_conversation_data": 1,
  "conversation_data_api_permission": "Read",
  "allow_guest": 0,
  "agent_color": "#6366F1"
}
