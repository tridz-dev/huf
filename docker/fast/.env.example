# FasterDocker environment overrides.
# Copy this file to .env in the worktree root and adjust values.

# Image tags
HUF_IMAGE_TAG=latest
HUF_APP_IMAGE=huf-app
SEED_IMAGE_SQL=huf-site-seed-sql
SEED_IMAGE_PHYSICAL=huf-site-seed-physical

# Frappe / site
SITE_NAME=huf.localhost
APP_NAME=huf

# Platform for multi-arch builds
DOCKER_PLATFORM=linux/arm64

# MariaDB exact image. For physical snapshots the digest is recorded in seed metadata.
MARIADB_IMAGE=mariadb:10.11.11

# Demo credentials (insecure, for local demo only)
MARIADB_ROOT_PASSWORD=fasterdocker-mysql-root
ADMIN_PASSWORD=fasterdocker-admin

# Bench profile ports
BENCH_WEB_PUBLISH_PORT=8000
BENCH_SOCKETIO_PUBLISH_PORT=9000

# Frontend port (split profile only)
FRONTEND_PUBLISH_PORT=8080

# Gunicorn tuning (split profile only)
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Bench dev profile tuning
BENCH_START_PORT=8000
BENCH_WORKER_QUEUES=default,short,long

# Nginx proxy settings (split profile only)
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
