          "id": "node_1793273087880",
          "type": "transform",
          "config": {
            "op": "upper",
            "input": {
              "text": {
                "$from": "node_1793273086417"
              }
            }
          },
          "next": "node_1793273089312",
          "_label": "Shout",
          "_position": {
            "x": 250,
            "y": 400
          }
        },
        {
          "id": "node_1793273089312",
