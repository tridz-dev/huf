{
  "_about": "Golden vectors for the Condition builder: the same model must compile to the same text in Python (huf/ai/flow/support/condition/condition_compile.py) and TypeScript (compile.ts). Every expression here also parses back to the model (parse.ts). Read by both test suites.",
  "vectors": [
    {"name": "number more than", "expression": "number(input['amount']) > 100",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.amount", "op": "gt", "value": {"kind": "number", "text": "100"}, "numeric": true}]}},
    {"name": "number less than plain", "expression": "input['amount'] < 5.5",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.amount", "op": "lt", "value": {"kind": "number", "text": "5.5"}}]}},
    {"name": "at least", "expression": "number(input['qty']) >= 3",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.qty", "op": "gte", "value": {"kind": "number", "text": "3"}, "numeric": true}]}},
    {"name": "at most negative", "expression": "number(input['t']) <= -2",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.t", "op": "lte", "value": {"kind": "number", "text": "-2"}, "numeric": true}]}},
    {"name": "text is", "expression": "input['status'] == 'Paid'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.status", "op": "is", "value": {"kind": "text", "text": "Paid"}}]}},
    {"name": "text is ignoring case", "expression": "lower(input['status']) == lower('Paid')",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.status", "op": "is", "value": {"kind": "text", "text": "Paid"}, "ignoreCase": true}]}},
    {"name": "text is not", "expression": "input['status'] != 'Refunded'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.status", "op": "is_not", "value": {"kind": "text", "text": "Refunded"}}]}},
    {"name": "number is", "expression": "number(input['n']) == 42",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.n", "op": "is", "value": {"kind": "number", "text": "42"}, "numeric": true}]}},
    {"name": "number is not", "expression": "number(input['n']) != 0",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.n", "op": "is_not", "value": {"kind": "number", "text": "0"}, "numeric": true}]}},
    {"name": "contains", "expression": "'vip' in input['tags']",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.tags", "op": "contains", "value": {"kind": "text", "text": "vip"}}]}},
    {"name": "contains ignoring case", "expression": "lower('VIP') in lower(input['note'])",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.note", "op": "contains", "value": {"kind": "text", "text": "VIP"}, "ignoreCase": true}]}},
    {"name": "does not contain", "expression": "not ('spam' in input['note'])",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.note", "op": "not_contains", "value": {"kind": "text", "text": "spam"}}]}},
    {"name": "starts with", "expression": "startswith(input['sku'], 'AB-')",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.sku", "op": "starts_with", "value": {"kind": "text", "text": "AB-"}}]}},
    {"name": "ends with ignoring case", "expression": "endswith(lower(input['mail']), lower('@X.com'))",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.mail", "op": "ends_with", "value": {"kind": "text", "text": "@X.com"}, "ignoreCase": true}]}},
    {"name": "is empty", "expression": "input['email'] in [None, '', [], {}]",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.email", "op": "is_empty"}]}},
    {"name": "is not empty", "expression": "input['email'] not in [None, '', [], {}]",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.email", "op": "is_not_empty"}]}},
    {"name": "is yes", "expression": "input['vip'] == True",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.vip", "op": "is_yes"}]}},
    {"name": "is no", "expression": "input['vip'] == False",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.vip", "op": "is_no"}]}},
    {"name": "is one of", "expression": "input['country'] in ['IN', 'US']",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.country", "op": "one_of", "value": {"kind": "list", "items": [{"kind": "text", "text": "IN"}, {"kind": "text", "text": "US"}]}}]}},
    {"name": "is none of numbers", "expression": "number(input['code']) not in [1, 2.5]",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.code", "op": "none_of", "value": {"kind": "list", "items": [{"kind": "number", "text": "1"}, {"kind": "number", "text": "2.5"}]}, "numeric": true}]}},
    {"name": "is one of ignoring case", "expression": "lower(input['c']) in [lower('IN'), lower('Us')]",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.c", "op": "one_of", "value": {"kind": "list", "items": [{"kind": "text", "text": "IN"}, {"kind": "text", "text": "Us"}]}, "ignoreCase": true}]}},
    {"name": "compare to another field", "expression": "number(input['total']) > number(input['limit'])",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.total", "op": "gt", "value": {"kind": "ref", "ref": "input.limit"}, "numeric": true}]}},
    {"name": "is another field text", "expression": "input['a'] == n1['b']['c']",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "ref", "ref": "n1.b.c"}}]}},
    {"name": "node field with list index", "expression": "n_http['items'][0]['sku'] == 'X'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "n_http.items[0].sku", "op": "is", "value": {"kind": "text", "text": "X"}}]}},
    {"name": "loop item", "expression": "foreach['item']['price'] > 10",
     "model": {"match": "all", "items": [{"type": "rule", "field": "foreach.item.price", "op": "gt", "value": {"kind": "number", "text": "10"}}]}},
    {"name": "trigger root", "expression": "trigger['x'] == 'y'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "trigger.x", "op": "is", "value": {"kind": "text", "text": "y"}}]}},
    {"name": "all of two", "expression": "number(input['amount']) > 100 and input['status'] == 'Paid'",
     "model": {"match": "all", "items": [
       {"type": "rule", "field": "input.amount", "op": "gt", "value": {"kind": "number", "text": "100"}, "numeric": true},
       {"type": "rule", "field": "input.status", "op": "is", "value": {"kind": "text", "text": "Paid"}}]}},
    {"name": "any of two", "expression": "input['a'] == 'x' or input['b'] == 'y'",
     "model": {"match": "any", "items": [
       {"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "x"}},
       {"type": "rule", "field": "input.b", "op": "is", "value": {"kind": "text", "text": "y"}}]}},
    {"name": "rule and any-group", "expression": "number(input['amount']) > 100 and (input['s'] == 'Paid' or input['s'] == 'Shipped')",
     "model": {"match": "all", "items": [
       {"type": "rule", "field": "input.amount", "op": "gt", "value": {"kind": "number", "text": "100"}, "numeric": true},
       {"type": "group", "match": "any", "items": [
         {"type": "rule", "field": "input.s", "op": "is", "value": {"kind": "text", "text": "Paid"}},
         {"type": "rule", "field": "input.s", "op": "is", "value": {"kind": "text", "text": "Shipped"}}]}]}},
    {"name": "any of rule and all-group", "expression": "input['vip'] == True or (input['a'] > 1 and input['b'] > 2)",
     "model": {"match": "any", "items": [
       {"type": "rule", "field": "input.vip", "op": "is_yes"},
       {"type": "group", "match": "all", "items": [
         {"type": "rule", "field": "input.a", "op": "gt", "value": {"kind": "number", "text": "1"}},
         {"type": "rule", "field": "input.b", "op": "gt", "value": {"kind": "number", "text": "2"}}]}]}},
    {"name": "group with one rule keeps its brackets", "expression": "(input['a'] == 'x')",
     "model": {"match": "all", "items": [{"type": "group", "match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "x"}}]}]}},
    {"name": "quote and backslash", "expression": "input['a'] == 'it\\'s a \\\\ path'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "it's a \\ path"}}]}},
    {"name": "newline tab and control", "expression": "input['a'] == 'l1\\nl2\\tx\\x01'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "l1\nl2\tx\u0001"}}]}},
    {"name": "injection attempt stays text", "expression": "input['a'] == '\\' or True or \\''",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "' or True or '"}}]}},
    {"name": "unicode text", "expression": "input['a'] == 'Zoë 日本'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "Zoë 日本"}}]}}
  ],
  "compile_only": [
    {"name": "no rules", "model": {"match": "all", "items": []}, "expression": ""},
    {"name": "incomplete rules are left out", "expression": "input['b'] == 'y'",
     "model": {"match": "all", "items": [
       {"type": "rule", "field": "", "op": "is", "value": {"kind": "text", "text": "x"}},
       {"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": ""}},
       {"type": "rule", "field": "input.a", "op": "gt"},
       {"type": "rule", "field": "input.a", "op": "gt", "value": {"kind": "number", "text": "abc"}},
       {"type": "rule", "field": "input.b", "op": "is", "value": {"kind": "text", "text": "y"}}]}},
    {"name": "empty group is left out", "expression": "input['a'] == 'x'",
     "model": {"match": "all", "items": [
       {"type": "group", "match": "any", "items": [{"type": "rule", "field": "", "op": "is_empty"}]},
       {"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "x"}}]}},
    {"name": "a bad reference is incomplete", "expression": "",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a b", "op": "is_empty"}]}},
    {"name": "numeric flag is ignored for text", "expression": "input['a'] == 'x'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "x"}, "numeric": true}]}},
    {"name": "ignore case is ignored for numbers", "expression": "input['a'] == 5",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "number", "text": "5"}, "ignoreCase": true}]}},
    {"name": "ignore case does not apply to more than", "expression": "input['a'] > 'b'",
     "model": {"match": "all", "items": [{"type": "rule", "field": "input.a", "op": "gt", "value": {"kind": "text", "text": "b"}, "ignoreCase": true}]}},
    {"name": "a group inside a group is left out", "expression": "input['a'] == 'x'",
     "model": {"match": "all", "items": [
       {"type": "rule", "field": "input.a", "op": "is", "value": {"kind": "text", "text": "x"}},
       {"type": "group", "match": "all", "items": [{"type": "group", "match": "all", "items": [{"type": "rule", "field": "input.z", "op": "is_yes"}]}]}]}}
  ],
  "hand_written_not_rules": [
    "input['vip'] and input['total'] >= 500",
    "not input['vip']",
    "input['a'] == 'x' and input['b'] == 'y' or input['c'] == 'z'",
    "input['a'] + 1 > 5",
    "'x' not in input['note']",
    "input['a'] > 1 > 0",
    "input['a'] == \"x\" and foo(1)",
    "(input['a'] == 'x' or (input['b'] == 'y' and input['c'] == 'z'))",
    "input['a'] in ['x', input['b']]",
    "lower(input['a']) > 'x'",
    "context.get('x')",
    "input[\"a\"][\"b\"] == 1 if True else False"
  ]
}
